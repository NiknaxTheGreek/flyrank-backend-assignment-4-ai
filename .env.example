# Copy to .env for local live-Supabase verification. Never commit .env.
SUPABASE_URL=https://your-project.supabase.co
# Preferred modern Supabase key:
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key
# Legacy compatibility fallback (use this only when publishable keys are unavailable):
# SUPABASE_ANON_KEY=your-public-anon-key